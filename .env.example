# ─── Site ──────────────────────────────────────────────────────────────
# Canonical production URL (used for sitemap, canonical tags, structured data)
NEXT_PUBLIC_SITE_URL=https://www.wheelwerks.net

# ─── Quote form delivery (REQUIRED for the form to deliver leads) ──────
# Resend (https://resend.com) — free tier is enough. Verify the sending domain first.
RESEND_API_KEY=
# Verified sender, e.g. "Wheel Werks Website <quotes@wheelwerks.net>"
QUOTE_FROM_EMAIL=
# Where leads go (comma-separated for multiple)
QUOTE_TO_EMAIL=

# ─── Anti-abuse (ALL REQUIRED in production before the form will deliver) ──
# Upstash Redis REST — shared rate limiting across serverless instances (free tier is enough)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare Turnstile (free CAPTCHA alternative)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Signs the form token (min fill time / expiry). 32+ random chars: openssl rand -hex 32
# Already set in Vercel for production + preview.
QUOTE_SIGNING_SECRET=

# ─── Analytics / Search Console (optional) ─────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# ─── Local development only ────────────────────────────────────────────
# Set to 1 to log (not deliver) quote submissions when email isn't configured
QUOTE_DEV_LOG=
